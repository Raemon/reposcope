{
  "name": "reposcope",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 2111",
    "build": "npm run check:caching && next build",
    "start": "next start --port 2111",
    "typecheck": "tsc --noEmit",
    "check:caching": "node scripts/checkGithubCaching.mjs"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
